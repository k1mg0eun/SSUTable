<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        style="@style/TopBar"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/IconButton"
            android:contentDescription="뒤로"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="설정"
            android:textSize="19sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 내 정보 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:text="내 정보" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profileName"
                        style="@style/Text.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/profileId"
                        style="@style/Text.Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfile"
                    style="@style/Widget.SSU.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="수정" />
            </LinearLayout>

            <View style="@style/Divider" />

            <!-- 권한 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:text="권한" />

            <LinearLayout
                android:id="@+id/permissionRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

            <View style="@style/Divider" />

            <!-- 알림 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:text="알림" />

            <LinearLayout
                android:id="@+id/alertRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/historyRow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="이용 기록" />

                <TextView
                    android:id="@+id/historyCount"
                    style="@style/Text.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/ink3" />
            </LinearLayout>

            <View style="@style/Divider" />

            <!-- 시연 모드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_sunk"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Text.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시연 모드" />

                <TextView
                    style="@style/Text.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="발표에서 시간대와 위치를 바꿔 보여 주는 설정이에요." />

                <TextView
                    android:id="@+id/virtualTime"
                    style="@style/Text.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="모드 지정" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/modeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeAuto"
                        style="@style/Widget.SSU.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="자동" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeBreakfast"
                        style="@style/Widget.SSU.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="아침" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeLunch"
                        style="@style/Widget.SSU.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="점심" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeStudy"
                        style="@style/Widget.SSU.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="스터디" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeClosed"
                        style="@style/Widget.SSU.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="종료" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="시각 옮기기" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="모드 지정이 '자동'일 때 시간표대로 모드가 바뀌어요" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/jumpRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="시간 배속" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/speedGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/speed1"
                            style="@style/Widget.SSU.Segment"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:text="1배" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/speed10"
                            style="@style/Widget.SSU.Segment"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:text="10배" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="내 위치" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/insideGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/inside"
                            style="@style/Widget.SSU.Segment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="학생회관 안" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/outside"
                            style="@style/Widget.SSU.Segment"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:text="밖" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/examSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="시험기간 (24:00까지 스터디)"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/demoPanelSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="내 예약 화면에 위치 버튼 보이기"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/conflictSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="다음 예약을 동시 예약 실패로 만들기"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetAll"
                    style="@style/Widget.SSU.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="0dp"
                    android:text="모든 데이터 지우고 처음부터"
                    android:textColor="@color/danger" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
