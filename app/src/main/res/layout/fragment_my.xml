<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <TextView
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 예약"
            android:textSize="19sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- 예약 없음 -->
            <LinearLayout
                android:id="@+id/emptyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="120dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_soft"
                    android:contentDescription="@null"
                    android:padding="18dp"
                    android:src="@drawable/ic_seat_empty"
                    app:tint="@color/ink2" />

                <TextView
                    style="@style/Text.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="예약한 자리가 없어요" />

                <TextView
                    style="@style/Text.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="좌석 맵에서 빈자리를 고르면\n여기서 도착과 이용 시간을 관리할 수 있어요" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyReserve"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="자리 예약하기" />
            </LinearLayout>

            <!-- 좌석 머리 -->
            <LinearLayout
                android:id="@+id/headerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/seatId"
                        style="@style/Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/modeTag"
                        style="@style/Text.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/seatSub"
                    style="@style/Text.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ticketBtn"
                        style="@style/Widget.SSU.Button.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="식권 QR" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/locateBtn"
                        style="@style/Widget.SSU.Button.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="좌석 위치" />
                </LinearLayout>
            </LinearLayout>

            <!-- 도착 대기 -->
            <LinearLayout
                android:id="@+id/waitGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_sunk"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <TextView
                    style="@style/Text.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="도착 마감까지" />

                <TextView
                    android:id="@+id/waitCountdown"
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.g1j2.ssutable.ui.view.BarView
                    android:id="@+id/waitBar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/waitDeadline"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <!-- 사용 중 -->
            <LinearLayout
                android:id="@+id/useGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="224dp"
                    android:layout_height="224dp">

                    <com.g1j2.ssutable.ui.view.RingView
                        android:id="@+id/useRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:ringWidth="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="남은 시간" />

                        <TextView
                            android:id="@+id/useCountdown"
                            style="@style/Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/useEnd"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFeatureSettings="tnum" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/extendNote"
                    style="@style/Text.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 자리 비움 -->
            <LinearLayout
                android:id="@+id/awayGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_warn"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/warn_ink" />

                <TextView
                    style="@style/Text.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="30분 안에 돌아오세요"
                    android:textColor="@color/warn_ink" />

                <TextView
                    style="@style/Text.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="복귀 마감까지"
                    android:textColor="@color/warn_ink" />

                <TextView
                    android:id="@+id/awayCountdown"
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/warn_ink" />

                <TextView
                    style="@style/Text.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="학생회관 안으로 돌아오면 사용 중으로 바뀌어요.\n그때까지 다른 사람은 이 자리를 예약할 수 없어요."
                    android:textColor="@color/warn_ink" />
            </LinearLayout>

            <!-- 종료 -->
            <LinearLayout
                android:id="@+id/endGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="48dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_soft"
                    android:contentDescription="@null"
                    android:padding="18dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/ink2" />

                <TextView
                    android:id="@+id/endHeadline"
                    style="@style/Text.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center" />

                <LinearLayout
                    android:id="@+id/endRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/endNote"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- 위치 -->
            <TextView
                android:id="@+id/locationLine"
                style="@style/Text.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- 시연 도구 -->
    <LinearLayout
        android:id="@+id/demoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_sunk"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="시연용 위치" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/insideToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/demoInside"
                style="@style/Widget.SSU.Segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="학생회관 안" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/demoOutside"
                style="@style/Widget.SSU.Segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="밖" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secondary"
            style="@style/Widget.SSU.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tertiary"
            style="@style/Widget.SSU.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />
    </LinearLayout>
</LinearLayout>
